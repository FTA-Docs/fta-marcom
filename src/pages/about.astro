---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import Reveal from '../components/Reveal.astro';
import MissionContent from '../../content/about/mission.md';
import ClinicalContent from '../../content/about/clinical.md';
import ComBContent from '../../content/about/com-b.md';
import TechnologyContent from '../../content/about/technology.md';
import FoundingTeamContent from '../../content/about/founding-team.md';
import teamData from '../../content/about/team.json';
import techData from '../../content/about/technology.json';
import pageData from '../../content/about/page.json';
import { emotionPaths } from '../lib/emotions';
---

<BaseLayout
  title={pageData.meta.title}
  description={pageData.meta.description}
>

  <!-- Hero / Our Mission — text left, image right (matches the homepage hero) -->
  <Panel size="sm">
    <div class="about-split about-hero">
      <div class="about-split__text">
        <Reveal><p class="eyebrow">{pageData.mission.eyebrow}</p></Reveal>
        <Reveal delay={50}><h1>{pageData.mission.heading}</h1></Reveal>
        <Reveal delay={100}>
          <div class="prose about-hero__prose">
            <MissionContent />
          </div>
        </Reveal>
      </div>
      <Reveal delay={150} class="about-split__visual">
        <figure class="about-figure">
          <div class="about-figure__frame">
            <img src="/teenageband.png" alt={pageData.mission.imageAlt} />
          </div>
          <svg class="about-figure__motif" viewBox="0 0 298 298" fill="none" aria-hidden="true" set:html={emotionPaths('Clarity')} />
        </figure>
      </Reveal>
    </div>
  </Panel>

  <!-- Clinical Experience — photo (circle) left, text right -->
  <Panel background="surface" class="about-pad">
    <div class="about-split about-split--reverse">
      <div class="about-split__text">
        <Reveal><h2>{pageData.clinical.heading}</h2></Reveal>
        <Reveal delay={100}>
          <div class="prose">
            <ClinicalContent />
          </div>
        </Reveal>
      </div>
      <Reveal delay={150} class="about-split__visual">
        <figure class="about-figure about-figure--tint">
          <div class="about-figure__frame">
            {pageData.clinical.image
              ? <img src={pageData.clinical.image} alt={pageData.clinical.imageAlt} />
              : <span class="about-figure__placeholder">{pageData.clinical.placeholder}</span>}
          </div>
          {pageData.clinical.caption && <figcaption class="about-figure__caption">{pageData.clinical.caption}</figcaption>}
        </figure>
      </Reveal>
    </div>
  </Panel>

  <!-- About COM-B — Venn diagram left, text right -->
  <Panel background="default" class="about-pad">
    <div class="about-split about-split--reverse">
      <div class="about-split__text">
        <Reveal><h2>{pageData.comb.heading}</h2></Reveal>
        <Reveal delay={100}>
          <div class="prose">
            <ComBContent />
          </div>
        </Reveal>
      </div>
      <Reveal delay={150} class="about-split__visual">
        <figure class="about-figure about-figure--plain">
          <img src={pageData.comb.image} alt={pageData.comb.imageAlt} />
        </figure>
      </Reveal>
    </div>
  </Panel>

  <!-- Our Technology — headline/copy + "Five Structural Layers" table left, graphic right -->
  <Panel background="surface" class="about-pad">
    <div class="about-split">
      <div class="about-split__text">
        <Reveal><h2>{pageData.technology.heading}</h2></Reveal>
        <Reveal delay={100}>
          <div class="prose about-prose-narrow">
            <TechnologyContent />
          </div>
        </Reveal>
      </div>
      <Reveal delay={150} class="about-split__visual">
        <figure class="about-figure about-figure--plain about-figure--wide">
          <picture>
            <source media="(max-width: 768px)" srcset={pageData.technology.imageMobile} />
            <img src={pageData.technology.image} alt={pageData.technology.imageAlt} />
          </picture>
        </figure>
      </Reveal>
    </div>

    <!-- Technology deep-dive modal: the five structural layers table -->
    <div class="tech-modal" id="tech-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="tech-modal-heading">
      <div class="tech-modal__backdrop"></div>
      <div class="tech-modal__panel">
        <button class="tech-modal__close" aria-label="Close">&times;</button>
        <div class="tech-modal__header">
          <h2 id="tech-modal-heading" class="tech-modal__heading">{techData.modalHeading}</h2>
        </div>
        <div class="tech-table-scroll">
          <div class="tech-table-wrap">
            <table class="tech-table">
              <thead>
                <tr>
                  <th scope="col">{techData.cols[0]}</th>
                  <th scope="col">{techData.cols[1]}</th>
                  <th scope="col">{techData.cols[2]}</th>
                </tr>
              </thead>
              <tbody>
                {techData.layers.map(layer => (
                  <tr>
                    <th scope="row">{layer.name}</th>
                    <td>{layer.adds}</td>
                    <td>{layer.why}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p class="tech-scroll-hint" aria-hidden="true">
          <span>Swipe to see more</span>
          <span class="tech-scroll-hint__arrow">→</span>
        </p>
      </div>
    </div>
  </Panel>

  <!-- Founding Team -->
  <Panel background="default" class="about-pad">
    <div class="about-section">
      <Reveal><h2>{pageData.team.heading}</h2></Reveal>
      <Reveal delay={100}>
        <div class="prose team-intro">
          <FoundingTeamContent />
        </div>
      </Reveal>
      <div class="team-grid">
        {teamData.members.map((member, i) => (
          <Reveal delay={i * 80}>
            <div class="team-card">
              <div class="team-avatar" aria-hidden="true">
                {member.headshot && <img src={member.headshot} alt={member.name} />}
              </div>
              <span class="team-name">{member.name}</span>
              <span class="team-title">{member.title}</span>
              <button
                class="team-bio-btn"
                data-bio-id={member.id}
                aria-label={pageData.team.bioButtonAria.replace('{name}', member.name)}
              >{pageData.team.bioButton}</button>
            </div>
          </Reveal>
        ))}
      </div>

      <!-- Bio Modal -->
      <div class="bio-modal" id="bio-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="bio-modal-name">
        <div class="bio-modal__backdrop"></div>
        <div class="bio-modal__panel">
          <button class="bio-modal__close" aria-label={pageData.team.modalCloseAria}>&times;</button>
          <div class="bio-modal__content">
            <div class="bio-modal__avatar"></div>
            <h3 class="bio-modal__name" id="bio-modal-name"></h3>
            <p class="bio-modal__title"></p>
            <p class="bio-modal__bio"></p>
            <a class="bio-modal__linkedin" href="#" target="_blank" rel="noopener noreferrer">{pageData.team.linkedinLabel}</a>
          </div>
        </div>
      </div>
    </div>
  </Panel>

</BaseLayout>

<style>
  /* Content sections: tighter than the default section padding so the
     page reads at a density closer to the rest of the site */
  :global(.about-pad) {
    padding-block: var(--space-12);
  }

  .about-hero__prose {
    max-width: 60ch;
    margin-top: var(--space-5);
  }

  .about-section {
    align-items: start;
  }

  .about-section h2 {
    margin-top: 0;
    margin-bottom: var(--space-5);
  }

  /* Body copy matches the homepage hero sub: base size, full text color */
  .prose :global(p) {
    color: var(--color-text);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  /* ── Two-column split (text + visual) ── */
  .about-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .about-split__text h2 {
    margin-top: 0;
    margin-bottom: var(--space-5);
  }

  .about-split--reverse .about-split__text { order: 2; }
  .about-split--reverse .about-split__visual { order: 1; }

  .about-prose-narrow { max-width: 64ch; }

  /* ── Photo figure (placeholder) ── */
  .about-figure { margin: 0; position: relative; }

  /* Clarity motif — drawn over the phone in the photo, spilling past the left
     edge into the whitespace (like the homepage science-panel motif). */
  .about-figure__motif {
    display: none; /* motif over photo hidden — re-enable by removing this line */
    position: absolute;
    left: -24%;
    bottom: -24%;
    width: 68%;
    aspect-ratio: 1 / 1;
    color: var(--pollen);
    overflow: visible;
    max-width: none;
    pointer-events: none;
    z-index: 2;
  }
  .about-figure__motif :global(path) {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .about-figure__frame {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-media);
    background: var(--color-surface-raised);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Spring-leaf tint — matches the homepage hero card. Applied to the Mission
     photo by section, and reused via the modifier class on other photos that
     should read with the same light, warm-green cast (e.g. Clinical). */
  .about-hero .about-figure__frame::before,
  .about-figure--tint .about-figure__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--spring-leaf) 25%, transparent);
    pointer-events: none;
    z-index: 1;
  }

  .about-figure__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-figure__placeholder {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-subtle);
  }

  .about-figure__caption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* ── Diagram figures that sit directly on the panel (no photo frame) ── */
  .about-figure--plain img {
    display: block;
    width: 100%;
    max-width: 560px;
    height: auto;
    margin-inline: auto;
  }

  /* Wide landscape diagrams (e.g. Technology architecture) fill the column */
  .about-figure--wide img { max-width: 100%; }

  /* ── Technology "Five Structural Layers" table ──
     Borrows the homepage comparison table's striping + typography; no
     highlighted (green) column here — every row is an Alignd layer. */

  /* Inline link opening the five-structural-layers modal (used within
     TechnologyContent markdown) */
  .tech-inline-link {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }
  .tech-inline-link:hover { opacity: 0.7; }
  .tech-inline-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Same button styled inline within TechnologyContent (markdown-rendered,
     so scoped selectors above don't reach it — needs :global()). */
  .prose :global(.tech-inline-link) {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }
  .prose :global(.tech-inline-link:hover) { opacity: 0.7; }
  .prose :global(.tech-inline-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Inline bio trigger within markdown content (e.g. "Dr. Michael Rich" in
     Clinical Knowledge) — opens the same bio modal as the Founding Team cards. */
  .prose :global(.bio-inline-link) {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }
  .prose :global(.bio-inline-link:hover) { opacity: 0.7; }
  .prose :global(.bio-inline-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .tech-table-wrap { overflow-x: auto; }

  /* Horizontal-scroll cue (mobile only — see the ≤767 block). On desktop the
     table fits the modal, so the fade and hint stay hidden. */
  .tech-table-scroll { position: relative; }
  .tech-scroll-hint { display: none; }

  .tech-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    font-size: var(--text-sm);
    /* Three text columns need room; scrolls horizontally on narrower screens. */
    min-width: 760px;
  }

  .tech-table th,
  .tech-table td {
    padding: var(--space-3) var(--space-5);
    text-align: left;
    vertical-align: top;
    line-height: var(--leading-normal);
  }

  /* Layer-name column narrower; the two explanation columns split the rest */
  .tech-table thead th:first-child,
  .tech-table tbody th { width: 26%; }

  /* Zebra striping, matching the comparison table */
  .tech-table tbody tr:nth-child(odd) td,
  .tech-table tbody tr:nth-child(odd) th {
    background: var(--light-beige);
  }

  .tech-table thead th {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-normal);
    color: var(--color-heading);
  }

  .tech-table tbody th {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    vertical-align: top;
  }

  .tech-table td { color: var(--color-text); white-space: pre-line; }

  /* ── Technology deep-dive modal (holds the five-layers table) ── */
  .tech-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal, 100);
    align-items: center;
    justify-content: center;
  }
  .tech-modal[aria-hidden="false"] { display: flex; }

  .tech-modal__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--midnight) 65%, transparent);
  }

  .tech-modal__panel {
    position: relative;
    background: var(--color-bg);
    border-radius: var(--radius-md);
    width: min(1220px, calc(100% - var(--space-6)));
    max-height: min(90vh, 820px);
    padding: var(--space-10) var(--space-8) var(--space-8);
    overflow: auto;
  }

  .tech-modal__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: none;
    border: none;
    font-size: var(--text-xl);
    line-height: 1;
    cursor: pointer;
    color: var(--color-text-muted);
  }
  .tech-modal__close:hover { color: var(--color-text); }

  .tech-modal__header { margin-bottom: var(--space-6); }

  .tech-modal__heading {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-2xl);
    color: var(--color-heading);
    margin: 0;
  }

  .team-intro {
    max-width: 64ch;
    margin-bottom: var(--space-10);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .team-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
  }

  .team-avatar {
    width: clamp(150px, 15vw, 196px);
    height: clamp(150px, 15vw, 196px);
    border-radius: var(--radius-full);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    aspect-ratio: 1;
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .team-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-name {
    font-weight: var(--weight-heading);
    font-size: var(--text-lg);
  }

  .team-title {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .team-bio-btn {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-accent);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .team-bio-btn:hover {
    opacity: 0.7;
  }

  .team-bio-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Bio Modal */
  .bio-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal, 100);
    align-items: center;
    justify-content: center;
  }

  .bio-modal[aria-hidden="false"] {
    display: flex;
  }

  .bio-modal__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--midnight) 60%, transparent);
  }

  .bio-modal__panel {
    position: relative;
    background: var(--color-surface, var(--white));
    border-radius: var(--radius-md);
    padding: var(--space-10);
    max-width: 480px;
    width: calc(100% - var(--space-8));
    max-height: min(85vh, 640px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .bio-modal__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .bio-modal__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: none;
    border: none;
    font-size: var(--text-xl);
    line-height: 1;
    cursor: pointer;
    color: var(--color-text-muted);
  }

  .bio-modal__close:hover {
    color: var(--color-text);
  }

  .bio-modal__avatar {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    overflow: hidden;
    flex-shrink: 0;
  }

  .bio-modal__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio-modal__name {
    font-size: var(--text-xl);
    font-weight: var(--weight-heading);
    margin: 0;
  }

  .bio-modal__title {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .bio-modal__bio {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0;
    text-align: left;
    white-space: pre-line;
  }

  .bio-modal__linkedin {
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .bio-modal__linkedin:hover {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .about-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    /* Always show text above the visual when stacked */
    .about-split--reverse .about-split__text { order: 0; }
    .about-split--reverse .about-split__visual { order: 0; }

    .about-figure__frame { aspect-ratio: 3 / 2; }

    /* Technology table: scroll horizontally; pin the layer-name column so the
       descriptions scroll underneath it (mirrors the comparison table). */
    .tech-table {
      min-width: 640px;
      font-size: var(--text-sm);
    }
    .tech-table th,
    .tech-table td {
      padding: var(--space-3) var(--space-4);
      line-height: var(--leading-snug);
    }
    .tech-table thead th:first-child,
    .tech-table tbody th { width: 124px; }
    .tech-table thead th:first-child,
    .tech-table th[scope="row"] {
      position: sticky;
      left: 0;
      z-index: 2;
      background: var(--color-bg);
    }
    .tech-table tbody tr:nth-child(odd) th[scope="row"] {
      background: var(--light-beige);
    }
    /* Narrow the middle column so the third column's edge peeks into view,
       backing up the fade + hint below. */
    .tech-table thead th:nth-child(2),
    .tech-table tbody td:first-of-type { width: 150px; }

    /* Right-edge fade signals the table continues past the viewport; it clears
       once the reader scrolls to the end (JS toggles .is-scrolled-end). */
    .tech-table-scroll::after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 44px;
      background: linear-gradient(to right, transparent, var(--color-bg));
      pointer-events: none;
      opacity: 1;
      transition: opacity var(--transition-base);
    }
    .tech-table-scroll.is-scrolled-end::after { opacity: 0; }

    /* Explicit hint naming the hidden column, so it's obvious one exists. */
    .tech-scroll-hint {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      margin: var(--space-4) 0 0;
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      transition: opacity var(--transition-base);
    }
    .tech-scroll-hint__arrow { transform: translateX(0); animation: tech-hint-nudge 1.4s ease-in-out infinite; }
    .tech-table-scroll.is-scrolled-end ~ .tech-scroll-hint { opacity: 0; }
    @keyframes tech-hint-nudge {
      0%, 100% { transform: translateX(0); }
      50% { transform: translateX(4px); }
    }
    @media (prefers-reduced-motion: reduce) {
      .tech-scroll-hint__arrow { animation: none; }
    }

    /* Modal fills more of the small screen so the table has room */
    .tech-modal__panel {
      width: calc(100% - var(--space-4));
      max-height: 92vh;
      padding: var(--space-8) var(--space-5) var(--space-5);
    }
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script define:vars={{ teamData }}>
  // Shared modal wiring: focus return + trap (WCAG 2.4.3 / 2.1.2), Escape and
  // backdrop close, and body-scroll lock. Returns { open, close }. Relies on the
  // BEM convention that the close button / backdrop end in __close / __backdrop.
  function createModal(modalEl) {
    const closeBtn = modalEl.querySelector('[class*="__close"]');
    const backdrop = modalEl.querySelector('[class*="__backdrop"]');
    let returnFocus = null;

    const focusable = () =>
      Array.from(
        modalEl.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      ).filter(el => el.offsetParent !== null);

    function open() {
      returnFocus = document.activeElement;
      modalEl.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      (closeBtn || modalEl).focus();
    }
    function close() {
      modalEl.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (returnFocus) returnFocus.focus();
    }

    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    modalEl.addEventListener('keydown', e => {
      if (e.key !== 'Tab') return;
      const f = focusable();
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && modalEl.getAttribute('aria-hidden') === 'false') close();
    });

    return { open, close };
  }

  // ── Bio modal — triggered from the Founding Team cards and from inline
  // mentions elsewhere on the page (e.g. Dr. Michael Rich in Clinical Knowledge) ──
  const bioModalEl = document.getElementById('bio-modal');
  if (bioModalEl) {
    const bioModal = createModal(bioModalEl);
    document.querySelectorAll('[data-bio-id]').forEach(btn => {
      btn.addEventListener('click', () => {
        const member = teamData.members.find(m => m.id === btn.dataset.bioId);
        if (!member) return;
        bioModalEl.querySelector('.bio-modal__name').textContent = member.name;
        bioModalEl.querySelector('.bio-modal__title').textContent = member.title;
        bioModalEl.querySelector('.bio-modal__bio').textContent = member.bio;
        bioModalEl.querySelector('.bio-modal__avatar').innerHTML = member.headshot
          ? `<img src="${member.headshot}" alt="${member.name}" />`
          : '';
        bioModalEl.querySelector('.bio-modal__linkedin').href = member.linkedin || '#';
        bioModal.open();
      });
    });
  }

  // ── Technology "closer look" modal (holds the five-layers table) ──
  const techModalEl = document.getElementById('tech-modal');
  if (techModalEl) {
    // Move to body so it escapes any transformed ancestor (Reveal) stacking.
    document.body.appendChild(techModalEl);
    const techModal = createModal(techModalEl);

    // Horizontal-scroll cue: show the fade + "swipe" hint until the table is
    // scrolled to its right end. clientWidth/scrollWidth are only meaningful
    // once the modal is visible, so refresh on open (rAF) and on scroll/resize.
    const techScroll = techModalEl.querySelector('.tech-table-scroll');
    const techWrap = techModalEl.querySelector('.tech-table-wrap');
    const refreshCue = () => {
      if (!techScroll || !techWrap) return;
      const atEnd = techWrap.scrollLeft + techWrap.clientWidth >= techWrap.scrollWidth - 4;
      techScroll.classList.toggle('is-scrolled-end', atEnd);
    };
    techWrap?.addEventListener('scroll', refreshCue, { passive: true });
    window.addEventListener('resize', refreshCue);

    document.querySelectorAll('[data-open-tech]').forEach(btn =>
      btn.addEventListener('click', () => {
        techModal.open();
        requestAnimationFrame(refreshCue);
      }));
  }
</script>
