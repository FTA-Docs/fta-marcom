---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import Accordion from '../components/Accordion.astro';
import Reveal from '../components/Reveal.astro';
import faqData from '../../content/faqs.json';
import { renderMarkdown } from '../lib/markdown';

// Answers are authored as markdown in the CMS; render to HTML at build time.
const categories = await Promise.all(
  faqData.categories.map(async (category) => ({
    ...category,
    faqs: await Promise.all(
      category.faqs.map(async (faq) => ({ ...faq, a: await renderMarkdown(faq.a) }))
    ),
  }))
);
---

<BaseLayout title="Support & FAQs" description="Get answers to common questions about alignd care coordination. Contact our support team at support@alignd.care.">

  <Panel size="sm">
    <Reveal><p class="eyebrow">{faqData.eyebrow}</p></Reveal>
    <Reveal delay={100}><h1>{faqData.heading}</h1></Reveal>
    <Reveal delay={150}>
      <div class="lead">
        <p>
          {faqData.intro} {faqData.contactNote.includes(faqData.contactEmail) ? (
            <Fragment>{faqData.contactNote.split(faqData.contactEmail)[0]}<a href={`mailto:${faqData.contactEmail}`}>{faqData.contactEmail}</a>{faqData.contactNote.split(faqData.contactEmail)[1]}</Fragment>
          ) : faqData.contactNote}
        </p>
        <p>{faqData.responseTime}</p>
      </div>
    </Reveal>
  </Panel>

  <Panel background="default" size="sm" class="faqs-panel">
    <div class="faqs-layout">
      {categories.map((category) => (
        <div class="faq-category">
          <Reveal><h2 class="faq-category__title">{category.category}</h2></Reveal>
          <div class="faq-list" role="list">
            {category.faqs.map((faq, i) => (
              <Reveal delay={i * 50}>
                <Accordion question={faq.q} answer={faq.a} />
              </Reveal>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Panel>

</BaseLayout>

<style>
  /* Intro copy matches the homepage hero sub: base size, full text color */
  .lead {
    max-width: 60ch;
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  .lead p {
    margin: 0;
    color: inherit;
    white-space: pre-line;
  }

  .lead p + p {
    margin-top: var(--space-4);
  }

  :global(.faqs-panel) {
    padding-block-start: var(--space-4);
  }

  .faqs-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .faq-category {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* In-document grouping label, not a panel heading: matches the legal pages'
     h2 rank (privacy-policy, terms). Family/weight/leading inherit from the
     global h2 rule. */
  .faq-category__title {
    margin: 0 0 var(--space-4);
    font-size: var(--text-2xl);
  }

  .faq-list {
    border-top: 1px solid var(--color-border);
  }
</style>

