---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import HealthSafetyContent from '../../content/legal/health-safety.md';
import legalPages from '../../content/legal/pages.json';
import '../styles/legal.css';

const { eyebrow, heading, lastUpdated } = legalPages.healthSafety;
---

<BaseLayout title="Health & Safety Information" description="Health and safety information for Alignd. Alignd is a coaching and education service, not a healthcare provider.">

  <Panel size="sm" class="legal-header">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p class="legal-meta">{lastUpdated}</p>
  </Panel>

  <Panel background="default" size="sm" class="legal-panel">
    <div class="legal-content">
      <HealthSafetyContent />
    </div>
  </Panel>

</BaseLayout>
