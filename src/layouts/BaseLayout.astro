---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  loadGSAP?: boolean;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Alignd helps families navigate care coordination across education, health, and development.',
  ogImage = '/soccer2.jpg',
  ogImageAlt = 'Alignd — personalized, evidence-based plans for family digital wellness',
  canonical,
  loadGSAP = false,
  bodyClass = '',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://alignd.care';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
// OG/Twitter images must be absolute URLs — resolve relative paths against the site origin.
const ogImageUrl = ogImage.startsWith('http') ? ogImage : siteUrl + ogImage;
const fullTitle = title === 'Alignd' ? title : title + ' | Alignd';
// GA4 only loads where the ID is set (Vercel production), so local dev isn't tracked.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Family Technology Advisors, LLC',
    alternateName: 'Alignd',
    url: siteUrl,
    logo: siteUrl + '/alignd_logo_fullcolor.svg',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        email: 'support@alignd.care',
        contactType: 'customer support',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    url: siteUrl,
    name: 'Alignd',
  },
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Lora:ital,wght@0,500;1,500&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Alignd" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={jsonLd} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Analytics (GA4) -->
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          // define:vars wraps this in a function scope, so expose gtag globally for later event calls.
          window.gtag = function gtag() { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
        <script is:inline>
          // Site-wide GA events (fta-marcom #14). Sends site text and paths only, never form input.
          (function () {
            var APP_HOSTS = ['app.alignd.care', '129.212.188.37'];

            // ui_click: every link or button click, wherever it is on the page.
            function label(el) {
              var text = el.getAttribute('data-ga-label') || el.getAttribute('aria-label') ||
                el.textContent || el.getAttribute('title') || '';
              return text.replace(/\s+/g, ' ').trim().slice(0, 100) || 'unlabeled';
            }
            function target(el) {
              if (el.tagName !== 'A' || !el.getAttribute('href')) return '';
              var url;
              try { url = new URL(el.href, location.href); } catch (e) { return ''; }
              if (url.protocol === 'mailto:') return 'mailto';
              if (url.protocol === 'tel:') return 'tel';
              if (APP_HOSTS.indexOf(url.hostname) !== -1) return 'app';
              if (url.origin === location.origin) return url.pathname + url.hash;
              return url.hostname;
            }
            function area(el) {
              var tagged = el.closest('[data-ga-area]');
              if (tagged) return tagged.getAttribute('data-ga-area');
              if (el.closest('.masthead')) return 'masthead';
              if (el.closest('.footer')) return 'footer';
              var modal = el.closest('[role="dialog"][id]');
              if (modal) return modal.id;
              var section = el.closest('section[id]');
              return section ? section.id : 'main';
            }
            document.addEventListener('click', function (e) {
              var el = e.target.closest && e.target.closest('a, button');
              if (!el) return;
              gtag('event', 'ui_click', {
                click_label: label(el),
                click_type: el.tagName === 'A' ? 'link' : 'button',
                click_target: target(el),
                click_area: area(el),
              });
            }, true);

            // scroll_depth: once per page view at each of 25/50/75/100%.
            var MARKS = [25, 50, 75, 100];
            var sent = {};
            function checkScroll() {
              var doc = document.documentElement;
              var seen = (window.scrollY + window.innerHeight) / Math.max(doc.scrollHeight, 1) * 100;
              MARKS.forEach(function (mark) {
                if (!sent[mark] && seen >= mark - 1) {
                  sent[mark] = true;
                  gtag('event', 'scroll_depth', { percent_scrolled: mark });
                }
              });
            }
            var pending = false;
            window.addEventListener('scroll', function () {
              if (pending) return;
              pending = true;
              setTimeout(function () { pending = false; checkScroll(); }, 250);
            }, { passive: true });
            window.addEventListener('load', checkScroll);
          })();
        </script>
      </>
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Masthead />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  main {
    padding-top: var(--masthead-h);
    /* Clip decorative motifs that intentionally spill past the page edges so
       they never trigger a horizontal scrollbar on narrow viewports. `clip`
       (not `hidden`) leaves the vertical axis visible, so the homepage's
       position:sticky panels and GSAP pinning are unaffected. */
    overflow-x: clip;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    background: var(--color-accent);
    color: var(--color-accent-text);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: var(--weight-semibold);
    z-index: calc(var(--z-masthead) + 10);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
