---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import TermsContent from '../../content/legal/terms.md';
import legalPages from '../../content/legal/pages.json';
import '../styles/legal.css';

const { eyebrow, heading, lastUpdated } = legalPages.terms;
---

<BaseLayout title="Terms of Use" description="Terms of Use for Alignd. Family Technology Advisors, LLC">

  <Panel size="sm" class="legal-header">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p class="legal-meta">{lastUpdated}</p>
  </Panel>

  <Panel background="default" size="sm" class="legal-panel">
    <div class="legal-content">
      <TermsContent />
    </div>
  </Panel>

</BaseLayout>
