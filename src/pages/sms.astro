---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import SmsContent from '../../content/legal/sms.md';
import legalPages from '../../content/legal/pages.json';
import '../styles/legal.css';

const { eyebrow, heading, lastUpdated } = legalPages.sms;
---

<BaseLayout title="Text Message Notifications" description="How Alignd text message (SMS) notifications work: opt-in, message frequency, rates, and how to opt out.">

  <Panel size="sm" class="legal-header">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p class="legal-meta">{lastUpdated}</p>
  </Panel>

  <Panel background="default" size="sm" class="legal-panel">
    <div class="legal-content">
      <SmsContent />
    </div>
  </Panel>

</BaseLayout>
